        "# 1. Usar a base de modelagem já carregada diretamente do Sheets\n",
        "dados_1_corrigido = df_modelagem.copy()\n",
        "\n",
        "# 2. Unir Realizado (df_realizado) com a Modelagem (dados_1_corrigido) usando as chaves do Frete\n",
        "df_consolidado = pd.merge(\n",
        "    df_realizado,\n",
        "    dados_1_corrigido,\n",
        "    on=['Nº frete', 'Item'],\n",
        "    how='left',\n",
        "    suffixes=('', '_modelagem')\n",
        ")\n",
        "\n",
        "# 3. Preparar as colunas de chave para unir com o Orçado (df_orcado_26)\n",
        "df_consolidado['Representante'] = df_consolidado['Representante'].astype(float).fillna(0).astype(int)\n",
        "df_consolidado['Centro cst'] = df_consolidado['Centro cst'].astype(float).fillna(0).astype(int)\n",
        "\n",
        "dados_2_temp = df_orcado_26.copy()\n",
        "dados_2_temp['Parceiro de Negócio'] = pd.to_numeric(dados_2_temp['Parceiro de Negócio'], errors='coerce').fillna(0).astype(int)\n",
        "dados_2_temp['Centro de custo'] = dados_2_temp['Centro de custo'].astype(int)\n",
        "\n",
        "# 4. Unir o resultado anterior com o Orçado (df_orcado_26)\n",
        "df_final = pd.merge(\n",
        "    df_consolidado,\n",
        "    dados_2_temp,\n",
        "    left_on=['Centro cst', 'Representante'],\n",
        "    right_on=['Centro de custo', 'Parceiro de Negócio'],\n",
        "    how='left',\n",
        "    suffixes=('', '_orcado')\n",
        ")\n",
        "\n",
        "# Visualizar o resultado final consolidado\n",
        "display(df_final.head())"
      ],
