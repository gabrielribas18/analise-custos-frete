        "import os\n",
        "\n",
        "def buscar_arquivos(diretorio, termos):\n",
        "    print(f\"Buscando arquivos e pastas contendo {termos} no seu Drive...\\n\")\n",
        "    encontrados = []\n",
        "    for raiz, pastas, arquivos in os.walk(diretorio):\n",
        "        # Evita buscar em pastas ocultas\n",
        "        pastas[:] = [p for p in pastas if not p.startswith('.')]\n",
        "\n",
        "        for nome in pastas + arquivos:\n",
        "            if any(termo.lower() in nome.lower() for termo in termos):\n",
        "                caminho_completo = os.path.join(raiz, nome)\n",
        "                encontrados.append(caminho_completo)\n",
        "                print(f\"Encontrado: {caminho_completo}\")\n",
        "\n",
        "    if not encontrados:\n",
        "        print(\"Nenhum arquivo ou pasta correspondente foi localizado no seu Drive.\")\n",
        "\n",
        "# Executa a busca na raiz do seu Google Drive\n",
        "buscar_arquivos('/content/drive/MyDrive', ['minoro', 'dados', 'frete', 'Orcado', 'Realizado'])"
      ],
